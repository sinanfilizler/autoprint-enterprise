// FitText.jsxinc
// =========================================================================
// Render_Sheet.jsx ve Audit_Templates.jsx'in ortak metin yerleştirme mantığı.
// İki script de bunu $.evalFile ile yükler; fit kuralı tek yerde durur.
// Her şey AP_FIT nesnesinin altında (global isim kirliliği olmasın).
// =========================================================================

var AP_FIT = (function () {
    var COLOR_CONFIG = {
        "BLACK": { r: 0, g: 0, b: 0 },
        "WHITE": { r: 240, g: 240, b: 240 },
        "IVORY": { r: 255, g: 255, b: 240 },
        "RED": { r: 180, g: 30, b: 40 },
        "GOLD": { r: 198, g: 141, b: 37 },
        "SILVER": { r: 180, g: 180, b: 180 },
        "GREEN": { r: 0, g: 134, b: 79 },
        "BLUE": { r: 0, g: 3, b: 216 }
    };

    var SIZES = {
        NAME:    { max: 54, min: 8, margin: 0.99 },
        YEAR:    { max: 32, min: 8, margin: 0.99 },
        MESSAGE: { max: 36, min: 8, margin: 0.99 }
    };

    function cleanText(t) {
        if(!t) return "";
        return String(t)
            .replace(/&amp;/g,"&")
            .replace(/&#039;/g,"'")
            .replace(/&quot;/g,'"')
            .replace(/&#39;/g,"'")
            .replace(/[‘’]/g,"'")
            .replace(/[“”]/g,'"');
    }

    // Asıl ölçüm: metin kutusunun (frame) width/height'ı — eskiden beri kullanılan.
    // Okunamaz ya da 0/NaN dönerse yedek olarak geometricBounds kullanılır (fb=true).
    function measure(tf) {
        try {
            var w = tf.width, h = tf.height;
            if (w > 0 && h > 0 && !isNaN(w) && !isNaN(h)) return { w: w, h: h, fb: false };
        } catch (e) {}
        try {
            var g = tf.geometricBounds;
            return { w: g[2] - g[0], h: g[1] - g[3], fb: true };
        } catch (e2) {}
        return { w: 0, h: 0, fb: true };
    }

    // Metni kutuya sığdırır. Metin boşsa ya da alan template'te yoksa null döner,
    // yoksa fit kaydı döner: {field, font, requestedFont, size, max, min, ratio, hitMin, overflow, fallback}
    function fitText(doc, tfName, bName, txt, font, sz, min, margin, colorCode) {
        var tf, b;
        try { tf = doc.textFrames.getByName(tfName); } catch (e) { return null; }
        try { b = doc.pathItems.getByName(bName); } catch (e) { return null; }
        txt = cleanText(txt); tf.contents = txt;
        if (!txt) { tf.hidden = true; return null; }
        tf.hidden = false;

        var ch = tf.textRange.characterAttributes;
        try { ch.textFont = app.textFonts.getByName(font); }
        catch (e) { try { ch.textFont = app.textFonts.getByName("MonotypeCorsiva"); } catch (x) {} }

        var cfg = COLOR_CONFIG[colorCode] || COLOR_CONFIG["BLACK"];
        var fill = new RGBColor(); fill.red = cfg.r; fill.green = cfg.g; fill.blue = cfg.b;
        ch.fillColor = fill; ch.size = sz;

        var usedFallback = false;
        var m = measure(tf); if (m.fb) usedFallback = true;
        while ((m.w > b.width * margin || m.h > b.height * margin) && ch.size > min) {
            ch.size -= 0.5;
            m = measure(tf); if (m.fb) usedFallback = true;
        }
        tf.position = [b.left + (b.width - m.w) / 2, tf.position[1]];

        var actualFont = "";
        try { actualFont = ch.textFont.name; } catch (e) {}
        var size = ch.size;
        return {
            field: tfName,
            font: actualFont,
            requestedFont: font,
            size: size,
            max: sz,
            min: min,
            ratio: sz ? size / sz : 0,
            hitMin: size <= min,
            overflow: (m.w > b.width * margin || m.h > b.height * margin),
            fallback: usedFallback
        };
    }

    // Raporlanması gereken durum mu? (MIN'e indi, hâlâ taşıyor, yedek ölçüm)
    function isProblem(r) {
        return !!r && (r.hitMin || r.overflow || r.fallback);
    }

    function problemReason(r) {
        var p = [];
        if (r.hitMin) p.push("MIN'e indi");
        if (r.overflow) p.push("taşıyor");
        if (r.fallback) p.push("yedek ölçüm");
        return p.join("; ");
    }

    return {
        COLOR_CONFIG: COLOR_CONFIG,
        SIZES: SIZES,
        cleanText: cleanText,
        measure: measure,
        fitText: fitText,
        isProblem: isProblem,
        problemReason: problemReason
    };
})();
